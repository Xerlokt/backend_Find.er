DATABASE_URL=postgresql://jobtinder:jobtinder@localhost:5432/jobtinder
DATABASE_URL_TEST=postgresql://jobtinder_test:jobtinder_test@localhost:5433/jobtinder_test
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobtinder
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (verificação por código). Sem SMTP_HOST, o código é impresso no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Find.er <no-reply@finder.app>

# Uploads de imagens (logo e fotos da empresa): pasta local e URL pública usada nos links
PUBLIC_URL=http://localhost:3000
UPLOADS_DIR=uploads
